<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing to bring back yet (a new library, or signed out). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_memory"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_watermark"
        android:layout_width="124dp"
        android:layout_height="124dp"
        android:layout_gravity="top|end"
        android:layout_marginEnd="-22dp"
        android:layout_marginTop="-26dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_mascot_watermark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical"
        android:padding="@dimen/widget_padding">

        <TextView
            android:id="@+id/widget_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:lineSpacingExtra="1sp"
            android:maxLines="2"
            android:text="@string/widget_empty_title"
            android:textColor="@color/widget_on_primary_container"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/widget_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif"
            android:maxLines="2"
            android:text="@string/widget_empty_body"
            android:textColor="@color/widget_on_primary_container_muted"
            android:textSize="12.5sp" />

        <TextView
            android:id="@+id/widget_cta"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/widget_button_cta"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:text="@string/widget_capture"
            android:textColor="@color/widget_on_primary"
            android:textSize="14sp" />
    </LinearLayout>
</FrameLayout>
