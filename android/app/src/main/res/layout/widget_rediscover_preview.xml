<?xml version="1.0" encoding="utf-8"?>
<!-- The widget picker preview (Android 12+): widget_rediscover.xml with
     the words filled in, since an include cannot carry sample text. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@android:id/background"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_memory"
    android:clipToOutline="true">

    <ImageView
        android:id="@+id/widget_watermark"
        android:layout_width="124dp"
        android:layout_height="124dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="-26dp"
        android:layout_marginEnd="-22dp"
        android:importantForAccessibility="no"
        android:src="@drawable/widget_mascot_watermark" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal"
        android:padding="@dimen/widget_padding">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:alpha="0.7"
                    android:importantForAccessibility="no"
                    android:src="@drawable/widget_ic_rewind" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:fontFamily="sans-serif-medium"
                    android:includeFontPadding="false"
                    android:letterSpacing="0.1"
                    android:maxLines="1"
                    android:text="@string/widget_eyebrow"
                    android:textAllCaps="true"
                    android:textColor="@color/widget_on_primary_container_muted"
                    android:textSize="10.5sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/widget_title"
                android:text="@string/widget_preview_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:lineSpacingExtra="1sp"
                android:maxLines="3"
                android:textColor="@color/widget_on_primary_container"
                android:textSize="18sp" />

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/widget_meta"
                    android:text="@string/widget_preview_meta"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif"
                    android:maxLines="1"
                    android:textColor="@color/widget_on_primary_container_muted"
                    android:textSize="12sp" />

                <FrameLayout
                    android:id="@+id/widget_next"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/widget_button_memory"
                    android:contentDescription="@string/widget_next">

                    <ImageView
                        android:layout_width="15dp"
                        android:layout_height="15dp"
                        android:layout_gravity="center"
                        android:importantForAccessibility="no"
                        android:src="@drawable/widget_ic_next" />
                </FrameLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
