<?xml version="1.0" encoding="utf-8"?>
<!-- Search, Ask and Save in one pill. The pill keeps its height and sits
     centred however tall the launcher makes the cell. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@android:id/background"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_gravity="center_vertical"
        android:background="@drawable/widget_bg_pill"
        android:clipToOutline="true"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="6dp">

        <LinearLayout
            android:id="@+id/widget_search_field"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/widget_search_field"
            android:contentDescription="@string/widget_search_hint"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingEnd="8dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ic_search" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:ellipsize="end"
                android:fontFamily="sans-serif"
                android:importantForAccessibility="no"
                android:maxLines="1"
                android:text="@string/widget_search_hint"
                android:textColor="@color/widget_on_surface_variant"
                android:textSize="15sp" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/widget_ask"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="4dp"
            android:background="@drawable/widget_button_ask"
            android:contentDescription="@string/widget_ask">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ic_ask" />
        </FrameLayout>

        <FrameLayout
            android:id="@+id/widget_capture"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_marginStart="6dp"
            android:background="@drawable/widget_button_capture"
            android:contentDescription="@string/widget_capture">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/widget_ic_plus" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
