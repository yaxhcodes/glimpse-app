<?xml version="1.0" encoding="utf-8"?>
<!--
    Notification icon for Glimpse.

    Requirements for Android notification icons:
      - Single colour (white) with a transparent background.
      - Rendered as a silhouette by the system; any colour is ignored on
        Android 5+ — only the alpha channel matters.
      - Vector drawable so it scales cleanly at every density.
      - Placed in drawable-anydpi-v24/ so it is used on Android 7.0+ (API 24+)
        where adaptive icon support is expected, AND in drawable/ as the
        fallback for older API levels covered by minSdk 24 in this project.

    Icon: simplified bell silhouette.
    Viewport: 24×24 dp (standard Material icon grid).
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24"
    android:tint="@android:color/white">

    <!--
        Bell body: a rounded arc sitting on a horizontal bar.
        Path derived from the Material Design "notifications" icon outline.
    -->
    <path
        android:fillColor="@android:color/white"
        android:pathData="M12,22c1.1,0 2,-0.9 2,-2h-4c0,1.1 0.9,2 2,2z
                          M18,16v-5c0,-3.07 -1.63,-5.64 -4.5,-6.32
                          V4c0,-0.83 -0.67,-1.5 -1.5,-1.5
                          s-1.5,0.67 -1.5,1.5v0.68
                          C7.64,5.36 6,7.92 6,11v5l-2,2v1h16v-1l-2,-2z" />
</vector>
